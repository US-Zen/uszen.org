{
  "name": "uszen.org",
  "version": "0.0.1",
  "scripts": {
    "start": "webpack serve --mode=development",
    "watch": "webpack watch --mode=development",
    "build": "webpack --mode=production --progress",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,css,scss,json,html}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/US-Zen/uszen.org.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.9.1",
    "daisyui": "^4.7.2",
    "html-bundler-webpack-plugin": "^3.4.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "nunjucks": "^3.2.4",
    "postcss": "^8.4.33",
    "postcss-loader": "^8.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.70.0",
    "sass-loader": "^14.0.0",
    "sitemap-webpack-plugin": "^1.1.1",
    "tailwindcss": "^3.4.1",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  }
}
